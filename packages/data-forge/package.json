{
  "name": "@blindrev/data-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "fetch": "tsx src/fetch.ts",
    "forge": "tsx src/cli.ts",
    "forge:pending": "tsx src/cli.ts --pending",
    "manifest": "tsx src/assets-manifest.ts",
    "verify": "tsx src/verify.ts",
    "gate-b": "tsx src/gate-b.ts",
    "all": "tsx src/cli.ts && tsx src/assets-manifest.ts && tsx src/verify.ts",
    "typecheck": "tsc --noEmit -p .",
    "build": "tsc --noEmit -p .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@blindrev/core-sim": "workspace:*",
    "pngjs": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "@types/node": "^26.6.6"
  }
}
